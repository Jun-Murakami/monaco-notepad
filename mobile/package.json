{
  "name": "monaco-notepad-mobile",
  "version": "1.6.1",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "scripts": {
    "eas-build-pre-install": "rm -f package-lock.json",
    "postinstall": "node scripts/generate-licenses.mjs",
    "generate-licenses": "node scripts/generate-licenses.mjs",
    "version": "node ../scripts/sync-version.mjs --bump-mobile-build && node scripts/generate-licenses.mjs",
    "start": "expo start",
    "prebuild": "node ../scripts/sync-version.mjs --bump-mobile-build && node scripts/generate-licenses.mjs && expo prebuild",
    "preandroid": "node ../scripts/sync-version.mjs --bump-mobile-build && node scripts/generate-licenses.mjs",
    "android": "expo run:android",
    "preios": "node ../scripts/sync-version.mjs --bump-mobile-build && node scripts/generate-licenses.mjs",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-vector-icons/material-design-icons": "^13.1.4",
    "@shikijs/core": "^4.4.3",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "expo": "~57.0.25",
    "expo-auth-session": "~57.0.13",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-shiki-engine": "^0.3.12",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.14",
    "@vitest/coverage-v8": "^5.0.1",
    "license-checker": "^25.0.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "decode-uri-component": "file:./vendor/decode-uri-component",
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
