# Monaco Notepad - build script environment variables
# このファイルを `.env` にコピーして実値を埋めてください (.env は gitignore 済)

# ============================================================
# macOS (build_mac.sh)
# ============================================================
APP_PATH="./build/bin/Monaco Notepad.app"
OUTPUT_PATH=./build/bin
APP_NAME="MonacoNotepad"
IDENTIFIER=XXXXXXXXXX.com.wails.MonacoNotepad
VERSION=1.0.0
DEVELOPER_ID_APP="Developer ID Application: Your Name (XXXXXXXXXX)"
DEVELOPER_ID_INSTALLER=XXXXXXXXXX
TEAM_ID=XXXXXXXXXX
APPLE_API_KEY_PATH="/absolute/path/to/AuthKey_XXXXXXXXXX.p8"
APPLE_API_KEY_ID="XXXXXXXXXX"
APPLE_API_ISSUER="00000000-0000-0000-0000-000000000000"

# ============================================================
# Windows (build.ps1) - Azure Key Vault コード署名
# ============================================================
# AzureSignTool で本体 exe + NSIS インストーラ両方を署名する。
# CLIENT_SECRET 未指定時は managed identity (-kvm) フォールバック。
AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net
AZURE_KEY_VAULT_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_KEY_VAULT_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_KEY_VAULT_CLIENT_SECRET=your-client-secret
AZURE_KEY_VAULT_CERTIFICATE=your-cert-name-in-key-vault
# 任意。デフォルトは http://timestamp.digicert.com
# AZURE_SIGN_TIMESTAMP_URL=http://timestamp.digicert.com
# ローカル動作確認用に署名スキップしたい場合は true
# SKIP_WIN_SIGN=true

# ============================================================
# Linux (build_linux.sh) - GPG 署名
# ============================================================
# SHA256SUMS の GPG 署名鍵 (鍵ID / フィンガープリント / メール)。
# 省略時は gpg の既定鍵を使う。
GPG_SIGNING_KEY=you@example.com
# 署名スキップ (SHA256SUMS のみ生成)
# SKIP_GPG_SIGN=true
# WebKit2GTK 4.1 を強制する場合 (Ubuntu 24.04+ で 4.0 が無いとき)
# WAILS_WEBKIT_TAG=41
