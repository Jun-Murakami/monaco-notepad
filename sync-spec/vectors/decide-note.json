        "downloaded": {
          "hash": "h2",
          "modifiedTime": "2026-01-01T00:00:20Z"
        }
      },
      "expected": {
        "kind": "upload",
        "backupRemote": true
      }
    },
    {
      "name": "ローカル未変更・リモートと同時刻ならリモートを採用",
