          "hash": "h2",
          "modifiedTime": "2026-01-01T00:00:10Z"
        },
        "localDeleted": false,
        "base": {
          "hash": "h1",
          "md5": "m1"
        },
        "remote": {
          "md5": "m2"
        },
        "downloaded": {
          "hash": "h3",
          "modifiedTime": "2026-01-01T00:00:05Z"
