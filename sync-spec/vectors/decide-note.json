        "local": {
          "hash": "h3",
          "modifiedTime": "2026-01-01T00:00:30Z"
        },
        "localDeleted": false,
        "base": {
          "hash": "h3",
          "md5": "m3"
        },
        "remote": {
          "md5": "m2"
